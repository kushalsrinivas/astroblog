---
// Component Script (between the frontmatter ---)
import { supabase } from '../lib/supabase';
import { formatDate } from '../utils/date';
import LikeButton from './LikeButton';
import ViewCounter from './ViewCounter';

const { category, tag, searchQuery } = Astro.props;

// Get user session
const { data: { session } } = await supabase.auth.getSession();
const userId = session?.user?.id;

// Fetch blogs with filters and engagement metrics
let query = supabase
  .from('blogs')
  .select(`
    *,
    author:users(name, avatar_url),
    likes:likes(count),
    bookmarks:bookmarks(count)
  `)
  .eq('published', true)
  .order('created_at', { ascending: false });

if (category) {
  query = query.eq('category', category);
}

if (tag) {
  query = query.contains('tags', [tag]);
}

if (searchQuery) {
  query = query.textSearch('title', searchQuery);
}

const { data: posts, error } = await query;

if (error) {
  console.error('Error fetching blogs:', error);
}
---

<!-- Component Template -->
<div class="blog-grid">
  {posts && posts.map(post => (
    <article class="blog-card">
      <a href={`/blog/${post.slug}`} class="card-link">
        <div class="image-container">
          <img 
            src={post.cover_image || `https://picsum.photos/seed/${post.id}/400/250`}
            alt={post.title}
          />
          <div class="category-tag">{post.category}</div>
        </div>
        <div class="content">
          <h2>{post.title}</h2>
          <p>{post.excerpt || post.content.substring(0, 150)}...</p>
          <div class="meta">
            <div class="author">
              <img 
                src={post.author?.avatar_url || `https://ui-avatars.com/api/?name=${post.author?.name}`}
                alt={post.author?.name}
                class="author-avatar"
              />
              <span>{post.author?.name}</span>
            </div>
            <span class="date">{formatDate(post.created_at)}</span>
          </div>
          <div class="tags">
            {post.tags.map((tag: string) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
          <div class="engagement">
            <LikeButton 
              client:load 
              blogId={post.id} 
              userId={userId} 
              initialLikes={post.likes[0]?.count || 0}
            />
            <ViewCounter count={post.views || 0} />
          </div>
        </div>
      </a>
    </article>
  ))}
</div>

<style>
  /* Previous styles remain the same */
  .engagement {
    display: flex;
    gap: var(--space-md);
    margin-top: var(--space-md);
    padding-top: var(--space-md);
    border-top: 2px solid var(--color-text);
  }
</style>
