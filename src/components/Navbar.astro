---
---
<nav class="navbar">
  <div class="nav-content">
    <div class="logo">
      <a href="/">BlogSpace</a>
    </div>
    <div class="nav-links">
      <a href="/" class="nav-item">Home</a>
      <a href="/explore" class="nav-item">Explore</a>
      <a href="/create" class="button">Create Post</a>
    </div>
  </div>
</nav>

<style>
  .navbar {
    background: var(--color-secondary);
    border-bottom: var(--border-brutal);
    position: fixed;
    top: 0;
    width: 100%;
    z-index: 1000;
    padding: var(--space-sm);
  }

  .nav-content {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo a {
    font-size: 2rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-text);
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    gap: var(--space-md);
    align-items: center;
  }

  .nav-item {
    font-weight: 500;
    text-transform: uppercase;
    position: relative;
  }

  .nav-item::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 100%;
    height: 2px;
    background: var(--color-text);
    transform: scaleX(0);
    transition: transform 0.2s ease;
  }

  .nav-item:hover::after {
    transform: scaleX(1);
  }

  @media (max-width: 768px) {
    .nav-links {
      gap: var(--space-sm);
    }
    
    .nav-item {
      font-size: 0.9rem;
    }

    .button {
      padding: var(--space-xs) var(--space-sm);
    }
  }
</style>
