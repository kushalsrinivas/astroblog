---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="BlogSpace - Share Your Stories" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet">
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
<style is:global>
	:root {
		/* Neobrutalist Color Palette */
		--color-background: #F2F0EB;
		--color-text: #1A1A1A;
		--color-primary: #1A1A1A;
		--color-secondary: #E6E2D8;
		--color-accent: #FF4D4D;
		--color-muted: #B3B3B3;
		
		/* Shadows and Borders */
		--shadow-brutal: 4px 4px 0 var(--color-text);
		--border-brutal: 3px solid var(--color-text);
		
		/* Spacing */
		--space-xs: 0.5rem;
		--space-sm: 1rem;
		--space-md: 2rem;
		--space-lg: 3rem;
		--space-xl: 4rem;
	}
	
	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}
	
	html {
		font-family: 'Space Grotesk', system-ui, sans-serif;
		background: var(--color-background);
		-webkit-font-smoothing: antialiased;
	}

	body {
		min-height: 100vh;
		color: var(--color-text);
		line-height: 1.5;
	}

	h1, h2, h3, h4, h5, h6 {
		font-weight: 700;
		line-height: 1.2;
		text-transform: uppercase;
	}

	a {
		color: inherit;
		text-decoration: none;
		transition: all 0.2s ease;
	}

	button, .button {
		font-family: 'Space Grotesk', system-ui, sans-serif;
		font-weight: 700;
		text-transform: uppercase;
		padding: var(--space-sm) var(--space-md);
		border: var(--border-brutal);
		background: var(--color-secondary);
		box-shadow: var(--shadow-brutal);
		cursor: pointer;
		transition: transform 0.2s ease;
	}

	button:hover, .button:hover {
		transform: translate(-2px, -2px);
		box-shadow: 6px 6px 0 var(--color-text);
	}

	button:active, .button:active {
		transform: translate(0, 0);
		box-shadow: 2px 2px 0 var(--color-text);
	}

	input, textarea {
		font-family: 'Space Grotesk', system-ui, sans-serif;
		padding: var(--space-sm);
		border: var(--border-brutal);
		background: white;
		width: 100%;
	}

	input:focus, textarea:focus {
		outline: none;
		box-shadow: var(--shadow-brutal);
	}
</style>
